# Copy to .env and adjust if your backend runs somewhere else.
# Base URL of the real hims-server backend (see ../hims-server), including its
# global prefix. The backend's CORS_ORIGINS must include this app's own origin
# (defaults to http://localhost:5173 in hims-server's own .env.example).
VITE_API_BASE_URL=http://localhost:3000/api/v1
