{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/mock",
              "@/mock/*",
              "**/mock",
              "**/mock/*"
            ],
            "message": "Screens must not touch the mock store. Import from src/api/* instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/api/**",
        "src/mock/**",
        "src/test/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/app/screens.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}